Window.Open(1280, 720, "moonBASIC Demo")
Render.SetFPS(60)

cam = Camera.Create()
cam.SetPos(0, 5, -12)
cam.SetFOV(75)

sun = Light.Create("directional")
sun.SetDir(-1, -2, -1)
sun.SetIntensity(1.0)
sun.SetShadow(TRUE)

groundMesh = Terrain.Create(256, 256)
groundMesh.FillPerlin(0.03, 20)

robot = Model.Load("assets/robot.mdl")

Physics3D.Start()
Physics3D.SetGravity(0, -9.8, 0)

groundDef = Body3D.Create("static")
groundDef.AddBox(100, 1, 100)
ground = groundDef.Commit(0, -0.5, 0)

heroDef = Body3D.Create("dynamic")
heroDef.AddCapsule(0.4, 1.8)
hero = heroDef.Commit(0, 5, 0)
hero.SetMass(80)

Physics3D.OnCollision(hero, ground, "OnLand")

mus = Audio.LoadMusic("assets/theme.ogg")
landSnd = Audio.LoadSound("assets/land.wav")
mus.Play()

WHILE NOT Input.KeyDown(KEY_ESCAPE)

    dt = Time.Delta()

    IF Input.KeyDown(KEY_W) THEN cam.Move(0, 0,  5.0 * dt)
    IF Input.KeyDown(KEY_S) THEN cam.Move(0, 0, -5.0 * dt)
    IF Input.KeyDown(KEY_A) THEN cam.Move(-5.0 * dt, 0, 0)
    IF Input.KeyDown(KEY_D) THEN cam.Move( 5.0 * dt, 0, 0)

    IF Input.KeyHit(KEY_SPACE) THEN
        hero.ApplyImpulse(0, 600, 0)
    ENDIF

    Physics3D.Step()
    mus.Update()

    robot.SetPos(0, 0, 0)
    robot.SetRot(0, 45 * dt, 0)

    y = groundMesh.GetHeight(0, 0)
    cam.SetPos(0, y + 1.8, -12)

    Render.Clear(10, 10, 20)
    cam.Begin()
    groundMesh.Draw()
    robot.Draw()
    cam.End()
    Render.Frame()

WEND

robot.Free()
groundMesh.Free()
sun.Free()
mus.Free()
Physics3D.Stop()
Window.Close()

FUNCTION OnLand(a, b)
    Audio.Play(landSnd)
ENDFUNCTION
